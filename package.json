{
  "name": "sahayak-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/server.ts",
    "server:dev": "tsx watch server/server.ts",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"tsx watch server/server.ts\" \"vite\"",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
